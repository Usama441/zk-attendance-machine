<% content_for :title, "Corrections" %>

<div class="page-head" data-reveal>
  <div>
    <div class="eyebrow"><svg class="ic" style="width:14px;height:14px"><use href="#i-shield"/></svg>Audited changes</div>
    <h1>Attendance corrections</h1>
    <p>Correct a punch time, add a missing punch, or void a wrong one. Raw device logs stay available for audit.</p>
  </div>
</div>

<section class="card" data-reveal>
  <%= form_with url: corrections_path, method: :get do |f| %>
    <div class="form-row">
      <label class="field" style="flex:2;min-width:220px">Employee
        <%= f.select :employee_id, @employees.map { |e| [e.label, e.id] },
              { include_blank: "— choose an employee —", selected: @employee&.id }, class: "user-select" %>
      </label>
      <label class="field">From <%= f.date_field :from, value: @from.to_s %></label>
      <label class="field">To <%= f.date_field :to, value: @to.to_s %></label>
      <%= button_tag type: "submit", class: "btn" do %>
        <svg class="ic"><use href="#i-search"/></svg><span>Show punches</span>
      <% end %>
    </div>
  <% end %>
</section>

<% if @employee %>
  <% active_count = @punches.count { |p| !p.voided } %>
  <section class="card" data-reveal>
    <div class="emp-head">
      <span class="emp-avatar"><%= @employee.name.to_s.split.map(&:first).first(2).join.upcase.presence || "#" %></span>
      <div>
        <h2><%= @employee.name %></h2>
        <div class="muted">
          <span>Code <b><%= @employee.uid %></b></span> ·
          <span><%= @from == @to ? @from.strftime("%a, %d %b %Y") : "#{@from.strftime('%d %b %Y')} → #{@to.strftime('%d %b %Y')}" %></span>
        </div>
      </div>
      <div class="emp-summary">
        <span class="chip"><b><%= active_count %></b> active</span>
        <%= link_to corrections_path(employee_id: @employee.id, from: @from, to: @to, show_voided: (@show_voided ? nil : "1")), class: "chip" do %>
          <b><%= @punches.size - active_count %></b> voided · <%= @show_voided ? "hide" : "show" %>
        <% end %>
        <span class="chip"><b><%= @punches_by_day.size %></b> day(s)</span>
      </div>
    </div>

    <%= render layout: "shared/data_table", locals: {
          id: "punches-table", search: "Search date, time, note…", per_page: 10, grouped: true,
          columns: ["Date", "Time", "Source", "Note", "By", "Status", { label: "", sort: false, class: "actions-cell" }],
          filters: [["All days", ""], ["Manual punches", "manual"], (["Voided", "voided"] if @show_voided)].compact,
          empty: "No punches in this range.", empty_icon: "i-calendar"
        } do %>
          <% @punches_by_day.each do |day, punches| %>
            <% punches.each_with_index do |p, i| %>
              <tr class="<%= 'voided' if p.voided %> <%= 'day-start' if i.zero? %>" data-filter="<%= [p.source, ('voided' if p.voided)].compact.join(' ') %>"<%= " data-cont".html_safe unless i.zero? %>>
                <% if i.zero? %>
                  <td rowspan="<%= punches.size %>" class="day-cell"><%= day.strftime("%d %b") %><small><%= day.strftime("%A") %></small></td>
                <% end %>
                <td class="time-cell"><%= p.punched_at.strftime("%I:%M %p") %></td>
                <td><span class="tag <%= p.source %>"><%= p.source %></span></td>
                <%# Correction notes stay in the DB for audit but are not shown. %>
                <% shown_note = p.note unless p.note.to_s.start_with?("Corrected from") %>
                <td><%= shown_note.presence || content_tag(:span, "—", class: "muted") %></td>
                <td><%= p.created_by.presence || content_tag(:span, "—", class: "muted") %></td>
                <td><span class="state <%= p.voided ? 'voided' : 'active' %>"><%= p.voided ? "Voided" : "Active" %></span></td>
                <td class="actions-cell">
                  <div class="action-stack">
                    <% unless p.voided? %>
                      <details class="correct-box">
                        <summary class="mini"><svg class="ic"><use href="#i-clock"/></svg>Correct time</summary>
                        <%= form_with url: replace_correction_path, method: :post, class: "correct-form" do |f| %>
                          <%= f.hidden_field :punch_id, value: p.id %>
                          <%= f.hidden_field :employee_id, value: @employee.id %>
                          <%= f.hidden_field :from, value: @from.to_s %>
                          <%= f.hidden_field :to, value: @to.to_s %>
                          <label>New time
                            <%= f.time_field :time, value: p.punched_at.strftime("%H:%M"), required: true %>
                          </label>
                          <%= button_tag type: "submit", class: "mini primary" do %>
                            <svg class="ic"><use href="#i-check"/></svg>Replace
                          <% end %>
                        <% end %>
                      </details>
                    <% end %>

                    <%= button_to void_correction_path,
                          params: { punch_id: p.id, employee_id: @employee.id, from: @from, to: @to }, method: :post,
                          class: "mini #{p.voided ? 'restore' : 'danger'}" do %>
                      <svg class="ic"><use href="#<%= p.voided ? 'i-undo' : 'i-trash' %>"/></svg><%= p.voided ? "Restore" : "Void" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
    <% end %>
  </section>

  <div class="grid-2" style="margin-top:20px">
    <section class="card" data-reveal>
      <div class="card-head">
        <span class="card-icon amber"><svg class="ic"><use href="#i-plus"/></svg></span>
        <div>
          <h2>Add a missing punch</h2>
          <p>Only for punches that are missing. To change an existing time, use <b>Correct time</b> next to that punch so the old record is left out of IN/OUT calculation.</p>
        </div>
      </div>
      <%= form_with url: corrections_path, method: :post do |f| %>
        <%= f.hidden_field :employee_id, value: @employee.id %>
        <%= f.hidden_field :from, value: @from.to_s %>
        <%= f.hidden_field :to, value: @to.to_s %>
        <div class="form-row" style="margin-bottom:16px">
          <label class="field">Date <%= f.date_field :date, value: @from.to_s, required: true %></label>
          <label class="field">Time <%= f.time_field :time, value: "09:00" %></label>
        </div>
        <label class="field">Note (reason)
          <%= f.text_field :note, placeholder: "e.g. forgot to punch / clocked in on another finger" %>
        </label>
        <%= button_tag type: "submit", class: "btn block" do %>
          <svg class="ic"><use href="#i-plus"/></svg><span>Add missing punch</span>
        <% end %>
      <% end %>
    </section>

    <section class="card" data-reveal>
      <div class="card-head">
        <span class="card-icon"><svg class="ic"><use href="#i-layers"/></svg></span>
        <div>
          <h2>Bulk add over date ranges</h2>
          <p>Adds the same time(s) to <b>every day</b> in each range. If a punch already exists at exactly that time, it is skipped.</p>
        </div>
      </div>
      <%= form_with url: bulk_correction_path, method: :post, class: "bulk-form" do |f| %>
        <%= f.hidden_field :employee_id, value: @employee.id %>
        <%= f.hidden_field :from, value: @from.to_s %>
        <%= f.hidden_field :to, value: @to.to_s %>

        <div class="bulk-section">
          <div class="bulk-title">Date ranges</div>
          <div id="range-list" class="rows">
            <div class="range-row">
              <label>From <input type="date" name="ranges[0][from]" value="<%= @from %>" required></label>
              <label>To <input type="date" name="ranges[0][to]" value="<%= @to %>" required></label>
              <button type="button" class="mini danger remove-row" title="Remove range"><svg class="ic"><use href="#i-x"/></svg></button>
            </div>
          </div>
          <button type="button" class="mini ghost" id="add-range"><svg class="ic"><use href="#i-plus"/></svg>Add range</button>
        </div>

        <div class="bulk-section">
          <div class="bulk-title">Times</div>
          <div id="time-list" class="rows">
            <div class="time-row">
              <label>Time <input type="time" name="times[]" value="09:00" required></label>
              <button type="button" class="mini danger remove-row" title="Remove time"><svg class="ic"><use href="#i-x"/></svg></button>
            </div>
            <div class="time-row">
              <label>Time <input type="time" name="times[]" value="18:00" required></label>
              <button type="button" class="mini danger remove-row" title="Remove time"><svg class="ic"><use href="#i-x"/></svg></button>
            </div>
          </div>
          <button type="button" class="mini ghost" id="add-time"><svg class="ic"><use href="#i-plus"/></svg>Add time</button>
        </div>

        <div class="bulk-section">
          <div class="form-row" style="gap:20px;margin-bottom:16px">
            <label class="check"><input type="checkbox" name="skip_wdays[]" value="0" checked> Skip Sundays</label>
            <label class="check"><input type="checkbox" name="skip_wdays[]" value="6"> Skip Saturdays</label>
          </div>
          <label class="field">Note (reason)
            <input type="text" name="note" placeholder="e.g. device was offline / on official duty" required>
          </label>
          <%= button_tag type: "submit", class: "btn block" do %>
            <svg class="ic"><use href="#i-layers"/></svg><span>Add punches to all ranges</span>
          <% end %>
          <div class="preview-box" id="bulk-preview"></div>
        </div>
      <% end %>
    </section>
  </div>

  <script>
    (function () {
      var form = document.querySelector(".bulk-form");
      if (!form) return;
      var rangeList = document.getElementById("range-list");
      var timeList = document.getElementById("time-list");
      var preview = document.getElementById("bulk-preview");
      var nextIdx = 1;

      function wireRemove(row, list) {
        row.querySelector(".remove-row").addEventListener("click", function () {
          if (list.children.length <= 1) return;
          var done = function () { row.remove(); updatePreview(); };
          window.ZK ? ZK.drop(row, done) : done();
        });
      }
      rangeList.querySelectorAll(".range-row").forEach(function (r) { wireRemove(r, rangeList); });
      timeList.querySelectorAll(".time-row").forEach(function (r) { wireRemove(r, timeList); });

      document.getElementById("add-range").addEventListener("click", function () {
        var row = rangeList.firstElementChild.cloneNode(true);
        row.querySelectorAll("input").forEach(function (inp) {
          inp.name = inp.name.replace(/ranges\[\d+\]/, "ranges[" + nextIdx + "]");
          inp.value = "";
        });
        nextIdx++;
        rangeList.appendChild(row);
        wireRemove(row, rangeList);
        if (window.ZK) ZK.pop(row);
        updatePreview();
      });

      document.getElementById("add-time").addEventListener("click", function () {
        var row = timeList.firstElementChild.cloneNode(true);
        row.querySelector("input").value = "";
        timeList.appendChild(row);
        wireRemove(row, timeList);
        if (window.ZK) ZK.pop(row);
        updatePreview();
      });

      // Count unique days (after weekday skips) so the admin sees the impact before submitting.
      function countDays() {
        var skip = Array.from(form.querySelectorAll("input[name='skip_wdays[]']:checked")).map(function (c) { return +c.value; });
        var days = {};
        rangeList.querySelectorAll(".range-row").forEach(function (row) {
          var ins = row.querySelectorAll("input");
          if (!ins[0].value) return;
          var a = new Date(ins[0].value + "T00:00:00Z");
          var b = new Date((ins[1].value || ins[0].value) + "T00:00:00Z");
          if (b < a) { var t = a; a = b; b = t; }
          for (var d = new Date(a); d <= b && Object.keys(days).length <= 400; d.setUTCDate(d.getUTCDate() + 1)) {
            if (skip.indexOf(d.getUTCDay()) === -1) days[d.toISOString().slice(0, 10)] = true;
          }
        });
        return Object.keys(days).length;
      }
      function countTimes() {
        return Array.from(timeList.querySelectorAll("input")).filter(function (i) { return i.value; }).length;
      }
      function updatePreview() {
        var d = countDays(), t = countTimes();
        preview.textContent = d + " day(s) × " + t + " time(s) = up to " + (d * t) + " punch(es) will be added.";
      }
      form.addEventListener("input", updatePreview);
      form.addEventListener("change", updatePreview);
      updatePreview();

      form.addEventListener("submit", function (e) {
        if (!confirm(preview.textContent + "\n\nContinue?")) e.preventDefault();
      });
    })();
  </script>
<% else %>
  <section class="card" data-reveal>
    <div class="empty" style="padding:48px 16px">
      <svg class="ic"><use href="#i-users"/></svg>
      <b style="color:var(--text)">Choose an employee</b><br>
      <span>Pick an employee and a date range above to view and correct their punches.</span>
    </div>
  </section>
<% end %>
