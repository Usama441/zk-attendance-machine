<%# Hide / show salary amounts (state kept in localStorage; see layout head script). %>
<button type="button" class="btn secondary money-toggle" data-money-toggle aria-label="Hide or show salary">
  <span class="when-shown"><svg class="ic"><use href="#i-eye-off"/></svg><span>Hide salary</span></span>
  <span class="when-hidden"><svg class="ic"><use href="#i-eye"/></svg><span>Show salary</span></span>
</button>
