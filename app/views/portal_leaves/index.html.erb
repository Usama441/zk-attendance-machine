<% content_for :title, "My leaves" %>

<div class="page-head" data-reveal>
  <div>
    <div class="eyebrow"><svg class="ic" style="width:14px;height:14px"><use href="#i-plane"/></svg>Leave</div>
    <h1>My leave requests</h1>
    <p>Apply for leave; an admin approves or rejects it. Approved paid leave is not counted as absent.</p>
  </div>
</div>

<div class="grid-2 leaves-grid">
  <section class="card" data-reveal>
    <div class="card-head">
      <span class="card-icon green"><svg class="ic"><use href="#i-plus"/></svg></span>
      <div>
        <h2>Apply for leave</h2>
        <p>Weekends inside the range are not counted.</p>
      </div>
    </div>
    <%= form_with model: @leave, url: portal_leaves_path, method: :post do |f| %>
      <label class="field">Leave type
        <%= f.select :leave_type, LeaveRequest::TYPES.map { |k, v| [v, k] } %>
      </label>
      <div class="form-row" style="margin:16px 0">
        <label class="field">From <%= f.date_field :start_date, required: true %></label>
        <label class="field">To <%= f.date_field :end_date, required: true %></label>
      </div>
      <label class="field">Reason
        <%= f.text_area :reason, rows: 3, maxlength: 500, required: true, placeholder: "e.g. family function, fever…" %>
      </label>
      <%= button_tag type: "submit", class: "btn block" do %>
        <svg class="ic"><use href="#i-plane"/></svg><span>Send request</span>
      <% end %>
    <% end %>
    <p class="hint"><svg class="ic"><use href="#i-alert"/></svg><span><b>Unpaid leave</b> approve hone par bhi salary se 1 din per day kat-ta hai. Casual / sick / annual leave approve ho to koi deduction nahi.</span></p>
  </section>

  <section class="card" data-reveal>
    <div class="card-head">
      <span class="card-icon"><svg class="ic"><use href="#i-layers"/></svg></span>
      <div><h2>All requests</h2><p>Pending requests can be cancelled.</p></div>
    </div>
    <%= render layout: "shared/data_table", locals: {
          id: "my-leaves", search: "Search dates, type or reason…", per_page: 10,
          columns: ["Dates", "Type", "Status", { label: "", sort: false, class: "actions-cell" }],
          filters: [["All", ""], ["Pending", "pending"], ["Approved", "approved"], ["Rejected", "rejected"], ["Cancelled", "cancelled"]],
          empty: "No leave requests yet.", empty_icon: "i-calendar"
        } do %>
          <% @leaves.each do |l| %>
            <tr data-filter="<%= l.status %>">
              <td data-sort="<%= l.start_date.iso8601 %>"><%= leave_dates(l) %><small class="block muted"><%= pluralize(l.days, "day") %> · <%= l.reason.truncate(60) %></small></td>
              <td><%= l.type_label %></td>
              <td>
                <%= leave_status_tag(l) %>
                <% if l.admin_note.present? %><small class="block muted">“<%= l.admin_note %>”</small><% end %>
              </td>
              <td class="actions-cell">
                <% if l.pending? %>
                  <%= button_to cancel_portal_leave_path(l), method: :post, class: "mini danger",
                        form: { onsubmit: "return confirm('Cancel this leave request?')" } do %>
                    <svg class="ic"><use href="#i-x"/></svg>Cancel
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
    <% end %>
  </section>
</div>
