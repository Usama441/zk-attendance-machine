<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? "#{yield(:title)} · Attendance Portal" : "Attendance Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0f172a">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/app.css?v=24">
    <script>
      document.documentElement.classList.add("js-anim");
      setTimeout(function () { document.documentElement.classList.remove("js-anim"); }, 2500);
      // Portal: salary amounts hidden/shown, remembered per browser (applied before paint).
      try { if (localStorage.getItem("zk-hide-money") === "1") document.documentElement.classList.add("money-hidden"); } catch (e) {}
      document.addEventListener("click", function (ev) {
        var btn = ev.target.closest("[data-money-toggle]");
        if (!btn) return;
        var hidden = document.documentElement.classList.toggle("money-hidden");
        try { localStorage.setItem("zk-hide-money", hidden ? "1" : "0"); } catch (e) {}
      });
    </script>
    <script src="/vendor/gsap.min.js" defer></script>
    <script src="/app.js?v=7" defer></script>
  </head>
  <% signed_in = logged_in? || employee_logged_in? %>
  <body class="<%= signed_in ? 'app' : 'auth' %><%= ' portal' if employee_logged_in? && !logged_in? %>">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="i-fingerprint" viewBox="0 0 24 24"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/><path d="M2 12a10 10 0 0 1 18-6"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M9 6.8a6 6 0 0 1 9 5.2v2"/></symbol>
        <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></symbol>
        <symbol id="i-edit" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></symbol>
        <symbol id="i-settings" viewBox="0 0 24 24"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></symbol>
        <symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
        <symbol id="i-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
        <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></symbol>
        <symbol id="i-download" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></symbol>
        <symbol id="i-sheet" viewBox="0 0 24 24"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/><path d="M14 2v6h6"/><path d="M8 13h2M14 13h2M8 17h2M14 17h2"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
        <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
        <symbol id="i-alert" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
        <symbol id="i-server" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></symbol>
        <symbol id="i-plug" viewBox="0 0 24 24"><path d="M12 22v-5"/><path d="M9 8V2M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
        <symbol id="i-layers" viewBox="0 0 24 24"><path d="m12 2 10 5-10 5L2 7Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
        <symbol id="i-eye-off" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-6.5 0-10-7-10-7a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19M1 1l22 22"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/></symbol>
        <symbol id="i-car" viewBox="0 0 24 24"><path d="M5 17H3v-5l2-5h14l2 5v5h-2"/><path d="M3 12h18"/><circle cx="7.5" cy="17" r="2"/><circle cx="16.5" cy="17" r="2"/><path d="M9.5 17h5"/></symbol>
        <symbol id="i-bike" viewBox="0 0 24 24"><circle cx="5.5" cy="17" r="3.5"/><circle cx="18.5" cy="17" r="3.5"/><path d="M5.5 17 9 9h5l4.5 8"/><path d="M14 9l-2-4H9.5M9 9l3 8h1"/></symbol>
        <symbol id="i-lock" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></symbol>
        <symbol id="i-activity" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></symbol>
        <symbol id="i-wallet" viewBox="0 0 24 24"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></symbol>
        <symbol id="i-plane" viewBox="0 0 24 24"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></symbol>
        <symbol id="i-chev-l" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
        <symbol id="i-chev-r" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
        <symbol id="i-undo" viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></symbol>
      </defs>
    </svg>

    <% if logged_in? %>
      <header class="topbar" data-anim="topbar">
        <div class="topbar-inner">
          <%= link_to root_path, class: "brand" do %>
            <span class="brand-mark"><svg class="ic"><use href="#i-fingerprint"/></svg></span>
            <span class="brand-text">Attendance Portal<small>Time &amp; attendance</small></span>
          <% end %>

          <nav class="nav" aria-label="Main">
            <span class="nav-indicator" aria-hidden="true"></span>
            <%= link_to root_path, class: ("active" if current_page?(root_path)) do %>
              <svg class="ic"><use href="#i-home"/></svg><span>Dashboard</span>
            <% end %>
            <%= link_to corrections_path, class: ("active" if current_page?(corrections_path)) do %>
              <svg class="ic"><use href="#i-edit"/></svg><span>Corrections</span>
            <% end %>
            <%= link_to employee_comments_path, class: ("active" if current_page?(employee_comments_path)) do %>
              <svg class="ic"><use href="#i-layers"/></svg><span>Comments</span>
            <% end %>
            <%= link_to leave_requests_path, class: ("active" if current_page?(leave_requests_path)) do %>
              <svg class="ic"><use href="#i-plane"/></svg><span>Leaves</span>
              <% if pending_leave_count.positive? %><span class="nav-count"><%= pending_leave_count %></span><% end %>
            <% end %>
            <%= link_to parking_requests_path, class: ("active" if current_page?(parking_requests_path)) do %>
              <svg class="ic"><use href="#i-car"/></svg><span>Parking</span>
              <% if pending_parking_count.positive? %><span class="nav-count"><%= pending_parking_count %></span><% end %>
            <% end %>
            <%= link_to payroll_path, class: ("active" if request.path.start_with?(payroll_path)) do %>
              <svg class="ic"><use href="#i-wallet"/></svg><span>Payroll</span>
            <% end %>
            <%= link_to settings_path, class: ("active" if current_page?(settings_path)) do %>
              <svg class="ic"><use href="#i-settings"/></svg><span>Settings</span>
            <% end %>
          </nav>

          <div class="user">
            <span class="avatar" aria-hidden="true"><%= current_admin.to_s.first(2).upcase %></span>
            <span class="user-meta"><small>Signed in as</small><b><%= current_admin %></b></span>
            <%= button_to logout_path, method: :delete, class: "icon-btn", title: "Sign out", form: { class: "logout-form" } do %>
              <svg class="ic"><use href="#i-logout"/></svg><span class="sr-only">Sign out</span>
            <% end %>
          </div>
        </div>
      </header>
    <% elsif employee_logged_in? %>
      <header class="topbar" data-anim="topbar">
        <div class="topbar-inner">
          <%= link_to portal_path, class: "brand" do %>
            <span class="brand-mark"><svg class="ic"><use href="#i-fingerprint"/></svg></span>
            <span class="brand-text">Attendance Portal<small>Employee portal</small></span>
          <% end %>

          <nav class="nav" aria-label="Main">
            <span class="nav-indicator" aria-hidden="true"></span>
            <% if portal_page?("home") %>
              <%= link_to portal_path, class: ("active" if current_page?(portal_path)) do %>
                <svg class="ic"><use href="#i-home"/></svg><span>Home</span>
              <% end %>
            <% end %>
            <% if portal_page?("attendance") %>
              <%= link_to portal_attendance_path, class: ("active" if current_page?(portal_attendance_path)) do %>
                <svg class="ic"><use href="#i-calendar"/></svg><span>Attendance</span>
              <% end %>
            <% end %>
            <% if portal_page?("salary") %>
              <%= link_to portal_salary_path, class: ("active" if current_page?(portal_salary_path)) do %>
                <svg class="ic"><use href="#i-wallet"/></svg><span>Salary</span>
              <% end %>
            <% end %>
            <% if portal_page?("leaves") %>
              <%= link_to portal_leaves_path, class: ("active" if current_page?(portal_leaves_path)) do %>
                <svg class="ic"><use href="#i-plane"/></svg><span>Leaves</span>
              <% end %>
            <% end %>
            <% if portal_page?("parking") %>
              <%= link_to portal_parking_path, class: ("active" if current_page?(portal_parking_path)) do %>
                <svg class="ic"><use href="#i-car"/></svg><span>Parking</span>
              <% end %>
            <% end %>
            <%= link_to portal_account_path, class: ("active" if current_page?(portal_account_path)) do %>
              <svg class="ic"><use href="#i-user"/></svg><span>Account</span>
            <% end %>
          </nav>

          <div class="user">
            <%= avatar(current_employee, "avatar") %>
            <span class="user-meta"><small>ID <%= current_employee.uid %></small><b><%= current_employee.name %></b></span>
            <%= button_to portal_logout_path, method: :delete, class: "icon-btn", title: "Sign out", form: { class: "logout-form" } do %>
              <svg class="ic"><use href="#i-logout"/></svg><span class="sr-only">Sign out</span>
            <% end %>
          </div>
        </div>
      </header>
    <% end %>

    <div class="toasts" id="toasts" aria-live="polite">
      <% if flash[:notice] %>
        <div class="toast ok" role="status"><svg class="ic"><use href="#i-check"/></svg><span><%= flash[:notice] %></span><button type="button" class="toast-close" aria-label="Dismiss"><svg class="ic"><use href="#i-x"/></svg></button></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="toast err" role="alert"><svg class="ic"><use href="#i-alert"/></svg><span><%= flash[:alert] %></span><button type="button" class="toast-close" aria-label="Dismiss"><svg class="ic"><use href="#i-x"/></svg></button></div>
      <% end %>
    </div>

    <main class="<%= signed_in ? 'page' : 'auth-page' %><%= ' portal-page' if employee_logged_in? && !logged_in? %>">
      <%= render "portal/missing_punches" if controller.is_a?(PortalController) && !logged_in? %>
      <%= yield %>
    </main>
  </body>
</html>
